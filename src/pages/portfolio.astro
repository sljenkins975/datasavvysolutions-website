---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
// Separate apps are linked only when an HTTPS destination exists; they never run inside this static site.
---
<Layout title="Demo portfolio" description="Try the Marketing Performance Analyzer with synthetic data and explore demo concepts for e-commerce reporting and data exploration. No client results are shown.">
  <div class="shell"><header class="page-intro"><p class="eyebrow">The demo portfolio</p><h1>Practical questions.<br />Possibilities in data.</h1><p class="lede">A look at the kinds of problems thoughtful analytics can help solve.</p></header>
  <p class="notice mb-12"><strong>Demonstration projects, not client engagements.</strong> Try the live Marketing Performance Analyzer with synthetic data. Other projects are planned concepts, and the illustrations are conceptual.</p>
  {projects.map((project, index) => <article class="project-row">
    {/* Show the complete screenshot, with a full-size link so small dashboard text stays readable. */}
    {project.screenshot ? <figure class="min-w-0 self-start">
      <a class="text-link block" href={`${base}${project.screenshot.src}`}>
        <img class="block h-auto w-full rounded-md border border-slate-200" src={`${base}${project.screenshot.src}`} alt={project.screenshot.alt} width="977" height="1162" loading="lazy" />
        <span class="mt-3 inline-block">View full-size screenshot</span>
      </a>
      <figcaption class="mt-2 text-sm text-muted">Synthetic sample data · Not client results</figcaption>
    </figure> : <div class="project-art min-w-0 self-start" aria-hidden="true">{[55, 92, 74, 125, 150].map((height, bar) => <i style={`height:${height - (index * bar * 5)}px`}></i>)}</div>}
    <div class="min-w-0">
      <span class="demo-label">{project.appUrl ? 'Live demo' : 'Demo project'} · {project.category}</span>
      <h2>{project.title}</h2>
      <p>{project.description}</p>
      <p class="mt-4"><strong>The question:</strong> {project.question}</p>
      {project.capabilities && <ul class="mt-5 list-disc space-y-2 pl-5 text-muted">{project.capabilities.map((capability) => <li>{capability}</li>)}</ul>}
      {project.disclosure && <p class="notice mt-6"><strong>Synthetic data demo.</strong> {project.disclosure}</p>}
      {/* Reuse wrapping actions and native links for touch targets, keyboard focus, and browser Back. */}
      {project.appUrl ? <div class="hero-actions">
        <a class="button" href={project.appUrl}>Try Live Demo <span class="sr-only">— {project.title}</span><span aria-hidden="true">↗</span></a>
        {project.sourceUrl && <a class="text-link inline-flex min-h-12 items-center" href={project.sourceUrl}>View Source Code <span class="sr-only">— {project.title} on GitHub</span></a>}
      </div> : <p class="status">Interactive demo planned · Preview concept only</p>}
    </div>
  </article>)}
  <section class="section" aria-label="Discuss your own data"><ContactCTA /></section></div>
</Layout>
